 	if (!rcar_gen3_are_all_rphys_power_off(channel))
 		goto out;
@@ -604,27 +791,59 @@ static int rcar_gen3_phy_usb2_power_on(struct phy *p)
 	/* The powered flag should be set for any other phys anyway */
 	rphy->powered = true;
 
