 drivers/clk/renesas/r9a09g056-cpg.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/clk/renesas/r9a09g056-cpg.c b/drivers/clk/renesas/r9a09g056-cpg.c
index 73c63cef8a99..b7d66148b42c 100644
